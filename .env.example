# ==============================================================================
# ABPS Textbook Distribution Platform — Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env.local AND POPULATE WITH REAL VALUES FOR LOCAL/STAGING.
# NEVER COMMIT .env.local OR REAL SECRETS TO THE GIT REPOSITORY.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Direct PostgreSQL or Supabase Transaction/Session Pooler connection URI.
# Consumed by: src/db/client.ts, drizzle.config.ts
# Local default fallback: postgresql://postgres:postgres@localhost:5432/abps_books
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@localhost:5432/abps_books

# ------------------------------------------------------------------------------
# 2. CLIENT & SERVER SUPABASE CONFIGURATION (PUBLIC)
# ------------------------------------------------------------------------------
# Supabase project URL and anonymous API key. Safe for browser exposure.
# Consumed by: src/lib/supabase/client.ts, src/lib/supabase/server.ts
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# ------------------------------------------------------------------------------
# 3. SERVER-ONLY SUPABASE ADMIN SECRET (STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------------------------
# Supabase service-role secret key. Bypasses RLS. NEVER EXPOSE TO CLIENT/BROWSER.
# Consumed by: src/lib/supabase/server.ts (createSupabaseAdminClient)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 4. CANONICAL APPLICATION SITE ORIGIN (PUBLIC)
# ------------------------------------------------------------------------------
# Canonical URL used for authentication redirects, password-recovery emails,
# and OAuth callbacks. Prevents serverless internal localhost redirects in production.
# Production value: https://abps-books.vercel.app
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://abps-books.vercel.app
